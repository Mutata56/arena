# Ежедневный бэкап, раздел 13 плана. Время выбрано после ночного окна генерации
# (02:00-06:00), чтобы в копию попадало и то, что конвейер написал ночью.
#
# Persistent=true обязателен: машина обычно живёт ночью, но если её выключали,
# пропущенный запуск случится сразу после включения, и день не останется без копии.

[Unit]
Description=arena: ежедневный бэкап базы

[Timer]
OnCalendar=*-*-* 07:00:00
RandomizedDelaySec=30m
Persistent=true
Unit=arena-backup.service

[Install]
WantedBy=timers.target
