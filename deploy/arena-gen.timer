# Ночное окно генерации, раздел 13 плана: 02:00-06:00.
# Стартовая точка 02:00, случайная задержка до четырёх часов размазывает запуск
# по всему окну: если demo_user ночью работает, ему не нужен ровно в два часа
# проснувшийся конвейер, жгущий лимиты.
#
# Persistent=true обязателен. Машина обычно живёт ночью, но если её выключили,
# пропущенный запуск случится сразу после включения, и утро не начнётся с пустого банка.

[Unit]
Description=arena: ночное окно генерации контента

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=4h
Persistent=true
Unit=arena-gen.service

[Install]
WantedBy=timers.target
